# ==============================================================================
# SIGAP-OPT Tanggamus - Apache Configuration & Security Hardening
# ==============================================================================

# 1. Matikan Directory Browsing (Listing Folder)
Options -Indexes -MultiViews

# 2. Proteksi File Sensitif & Source Code (.env, .git, .json, .ts, .map, dll.)
<FilesMatch "^\.|\.(env|json|config|ts|tsx|md|sql|log|lock|map|yml|yaml|bak|backup)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# Khusus izin akses file manifest & aset publik jika diperlukan
<Files "manifest.json">
  <IfModule mod_authz_core.c>
    Require all granted
  </IfModule>
  <IfModule !mod_authz_core.c>
    Allow from all
  </IfModule>
</Files>

# 3. Security Headers (Anti-Inspect, Anti-Clickjacking, Proteksi MIME & XSS)
<IfModule mod_headers.c>
  # Mencegah situs disematkan ke dalam iframe pihak ketiga (Clickjacking)
  Header always set X-Frame-Options "SAMEORIGIN"

  # Mencegah browser menduga-duga MIME type file (MIME Sniffing)
  Header always set X-Content-Type-Options "nosniff"

  # Mengaktifkan filter XSS di peramban
  Header always set X-XSS-Protection "1; mode=block"

  # Batasi kebocoran URL asal referer
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # Menonaktifkan fitur pelacak pihak ketiga / izin perangkat yang tidak dibutuhkan
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"

  # Nonaktifkan cache untuk file sensitif agar perubahan keamanan langsung efektif
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires 0
  </FilesMatch>
</IfModule>

# 4. Single Page Application (SPA) URL Rewrite ke index.html
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Jangan redirect file statis atau folder yang benar-benar ada
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

# 5. Kompresi Gzip / Deflate untuk Akselerasi Beban Aplikasi
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# 6. Cache Browser untuk Aset Gambar & Font Statis
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpg "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/gif "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>
