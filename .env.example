# =====================================================================
# SIPOPT Tanggamus - Environment Variables Configuration
# =====================================================================

# Server Port (Aplikasi otomatis mencari port kosong jika port ini sudah terpakai)
PORT=3000
AUTO_PORT=true
NODE_ENV=development

# ---------------------------------------------------------------------
# PostgreSQL Configuration (Otomatis Aktif jika DATABASE_URL diisi)
# ---------------------------------------------------------------------
# Format URL: postgresql://username:password@hostname:port/database_name
DATABASE_URL=postgresql://sipopt:sipopt_secret_pass_2026@localhost:5432/sipopt_db

# Atau gunakan parameter terpisah:
# PGHOST=localhost
# PGPORT=5432
# PGUSER=sipopt
# PGPASSWORD=sipopt_secret_pass_2026
# PGDATABASE=sipopt_db

# ---------------------------------------------------------------------
# WhatsApp Gateway (Baileys Open-Source Socket)
# ---------------------------------------------------------------------
# WhatsApp Baileys berjalan otomatis secara mandiri tanpa pihak ketiga.
# Sesi dan kredensial QR disimpan di folder ./data/baileys_auth

# ---------------------------------------------------------------------
# Optional External Integrations
# ---------------------------------------------------------------------
FONNTE_TOKEN=
GOOGLE_SPREADSHEET_ID=
GEMINI_API_KEY=
